# Backend API Base URL (required for API integration)
# In local development: http://localhost:5000
# In production: https://api.hkbharti77.website
VITE_API_URL=http://localhost:5000

# Optional fallback for backend URL
VITE_BACKEND_URL=http://localhost:5000

# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="https://hkbharti77.website"
